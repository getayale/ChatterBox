
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sign Up | ChatterBox</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6fb;
      color: #1e293b;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      text-decoration: none;
    }

    .topbar {
      background: #111827;
      color: #fff;
      padding: 20px 5%;
    }

    .topbar-content {
      width: min(1100px, 100%);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    .brand h1 {
      font-size: 26px;
      line-height: 1.3;
    }

    .brand p {
      color: #cbd5e1;
      font-size: 13px;
      margin-top: 4px;
    }

    .home-link {
      color: #e2e8f0;
      border: 1px solid #4b5563;
      border-radius: 7px;
      padding: 9px 13px;
      font-size: 13px;
      font-weight: 600;
      transition: background 0.2s;
    }

    .home-link:hover {
      background: #374151;
    }

    main {
      width: min(500px, 92%);
      margin: auto;
      padding: 38px 0;
    }

    .signup-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 15px;
      padding: 32px;
      box-shadow: 0 12px 35px rgba(15, 23, 42, 0.07);
    }

    .icon-wrapper {
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e0e7ff;
      border-radius: 13px;
      font-size: 27px;
      margin-bottom: 20px;
    }

    .eyebrow {
      color: #4f46e5;
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      margin-bottom: 7px;
    }

    h2 {
      color: #0f172a;
      font-size: 28px;
      line-height: 1.3;
      margin-bottom: 8px;
    }

    .description {
      color: #64748b;
      font-size: 14px;
      margin-bottom: 24px;
    }

    .errors {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 13px 16px;
      margin-bottom: 21px;
      font-size: 13px;
    }

    .errors h3 {
      font-size: 14px;
      margin-bottom: 6px;
    }

    .errors ul {
      padding-left: 19px;
    }

    .errors li + li {
      margin-top: 4px;
    }

    .form-group {
      margin-bottom: 17px;
    }

    label {
      display: block;
      color: #334155;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    input {
      display: block;
      width: 100%;
      padding: 12px 13px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      background: #fff;
      color: #0f172a;
      font-family: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    .password-wrapper {
      position: relative;
    }

    .password-wrapper input {
      padding-right: 72px;
    }

    .toggle-password {
      position: absolute;
      right: 9px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: #4f46e5;
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      padding: 6px;
      cursor: pointer;
    }

    .toggle-password:hover {
      color: #3730a3;
    }

    .password-hint {
      color: #94a3b8;
      font-size: 12px;
      margin-top: 6px;
    }

    .submit-btn {
      display: block;
      width: 100%;
      padding: 13px 16px;
      margin-top: 23px;
      background: #4f46e5;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
    }

    .submit-btn:hover {
      background: #4338ca;
    }

    .submit-btn:active {
      transform: scale(0.99);
    }

    .login-prompt {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #e2e8f0;
      text-align: center;
      color: #64748b;
      font-size: 13px;
    }

    .login-prompt a {
      color: #4f46e5;
      font-weight: 700;
    }

    .login-prompt a:hover,
    .bottom-link a:hover {
      text-decoration: underline;
    }

    .bottom-link {
      text-align: center;
      margin-top: 18px;
      font-size: 13px;
    }

    .bottom-link a {
      color: #64748b;
      font-weight: 600;
    }

    .footer {
      padding: 20px 15px;
      text-align: center;
      color: #94a3b8;
      font-size: 12px;
      margin-top: auto;
    }

    @media (max-width: 480px) {
      .topbar {
        padding: 17px 4%;
      }

      .brand h1 {
        font-size: 23px;
      }

      main {
        padding: 26px 0;
      }

      .signup-card {
        padding: 25px 20px;
      }

      h2 {
        font-size: 25px;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-content">
      <div class="brand">
        <h1>ChatterBox</h1>
        <p>Become part of our community.</p>
      </div>

      <a href="/" class="home-link">← Back to Home</a>
    </div>
  </header>

  <main>
    <section class="signup-card">
      <div class="icon-wrapper" aria-hidden="true">👤</div>

      <p class="eyebrow">Create Your Account</p>

      <h2>Join ChatterBox</h2>

      <p class="description">
        Create your account to share messages and connect
        with the community.
      </p>

      <% if (errors && errors.length > 0) { %>
        <div class="errors" role="alert">
          <h3>Please correct the following:</h3>

          <ul>
            <% errors.forEach(error => { %>
              <li><%= error.msg %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/signup" method="POST">
        <div class="form-group">
          <label for="firstName">First Name</label>

          <input
            type="text"
            id="firstName"
            name="firstName"
            value="<%= formData?.firstName || '' %>"
            placeholder="Enter your first name"
            required
            maxlength="100"
            autocomplete="given-name"
          >
        </div>

        <div class="form-group">
          <label for="lastName">Last Name</label>

          <input
            type="text"
            id="lastName"
            name="lastName"
            value="<%= formData?.lastName || '' %>"
            placeholder="Enter your last name"
            required
            maxlength="100"
            autocomplete="family-name"
          >
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>

          <input
            type="email"
            id="email"
            name="email"
            value="<%= formData?.email || '' %>"
            placeholder="you@example.com"
            required
            maxlength="255"
            autocomplete="email"
          >
        </div>

        <div class="form-group">
          <label for="password">Password</label>

          <div class="password-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Create a password"
              required
              minlength="8"
              maxlength="72"
              autocomplete="new-password"
            >

            <button
              class="toggle-password"
              type="button"
              data-target="password"
              aria-pressed="false"
            >
              Show
            </button>
          </div>

          <p class="password-hint">
            Use at least 8 characters.
          </p>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>

          <div class="password-wrapper">
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Enter your password again"
              required
              minlength="8"
              maxlength="72"
              autocomplete="new-password"
            >

            <button
              class="toggle-password"
              type="button"
              data-target="confirmPassword"
              aria-pressed="false"
            >
              Show
            </button>
          </div>
        </div>

        <button class="submit-btn" type="submit">
          Create Account →
        </button>
      </form>

      <div class="login-prompt">
        Already have an account?
        <a href="/login">Sign in</a>
      </div>

      <p class="bottom-link">
        <a href="/">Return to the home page</a>
      </p>
    </section>
  </main>

  <footer class="footer">
    ChatterBox &copy; <%= new Date().getFullYear() %>
    &mdash; Connect, share, and belong.
  </footer>

  <script>
    document.querySelectorAll(".toggle-password").forEach((button) => {
      button.addEventListener("click", () => {
        const input = document.getElementById(button.dataset.target);
        const isHidden = input.type === "password";

        input.type = isHidden ? "text" : "password";
        button.textContent = isHidden ? "Hide" : "Show";
        button.setAttribute("aria-pressed", String(isHidden));
      });
    });
  </script>
</body>
</html>
