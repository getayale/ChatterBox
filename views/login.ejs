
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sign In | ChatterBox</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6fb;
      color: #1e293b;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      text-decoration: none;
    }

    .topbar {
      background: #111827;
      color: #fff;
      padding: 20px 5%;
    }

    .topbar-content {
      width: min(1100px, 100%);
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    .brand h1 {
      font-size: 26px;
      line-height: 1.3;
    }

    .brand p {
      color: #cbd5e1;
      font-size: 13px;
      margin-top: 4px;
    }

    .home-link {
      color: #e2e8f0;
      border: 1px solid #4b5563;
      border-radius: 7px;
      padding: 9px 13px;
      font-size: 13px;
      font-weight: 600;
      transition: background 0.2s;
    }

    .home-link:hover {
      background: #374151;
    }

    main {
      width: min(460px, 92%);
      margin: auto;
      padding: 42px 0;
    }

    .login-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 15px;
      padding: 34px;
      box-shadow: 0 12px 35px rgba(15, 23, 42, 0.07);
    }

    .icon-wrapper {
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e0e7ff;
      border-radius: 13px;
      font-size: 27px;
      margin-bottom: 22px;
    }

    .eyebrow {
      color: #4f46e5;
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.2px;
      margin-bottom: 7px;
    }

    h2 {
      color: #0f172a;
      font-size: 28px;
      line-height: 1.3;
      margin-bottom: 9px;
    }

    .description {
      color: #64748b;
      font-size: 14px;
      margin-bottom: 25px;
    }

    .error-message {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 20px;
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .form-group {
      margin-bottom: 19px;
    }

    label {
      display: block;
      color: #334155;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    input {
      width: 100%;
      padding: 12px 13px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      background: #fff;
      color: #0f172a;
      font-family: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    .password-wrapper {
      position: relative;
    }

    .password-wrapper input {
      padding-right: 75px;
    }

    .toggle-password {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: #4f46e5;
      font-family: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      padding: 6px;
    }

    .toggle-password:hover {
      color: #3730a3;
    }

    .submit-btn {
      display: block;
      width: 100%;
      padding: 13px 16px;
      margin-top: 7px;
      background: #4f46e5;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
    }

    .submit-btn:hover {
      background: #4338ca;
    }

    .submit-btn:active {
      transform: scale(0.99);
    }

    .signup-prompt {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #e2e8f0;
      text-align: center;
      color: #64748b;
      font-size: 13px;
    }

    .signup-prompt a,
    .bottom-link a {
      color: #4f46e5;
      font-weight: 700;
    }

    .signup-prompt a:hover,
    .bottom-link a:hover {
      text-decoration: underline;
    }

    .bottom-link {
      text-align: center;
      margin-top: 20px;
      font-size: 13px;
    }

    .bottom-link a {
      color: #64748b;
      font-weight: 600;
    }

    .footer {
      padding: 20px 15px;
      text-align: center;
      color: #94a3b8;
      font-size: 12px;
      margin-top: auto;
    }

    @media (max-width: 480px) {
      .topbar {
        padding: 17px 4%;
      }

      .brand h1 {
        font-size: 23px;
      }

      main {
        padding: 28px 0;
      }

      .login-card {
        padding: 25px 20px;
      }

      h2 {
        font-size: 25px;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-content">
      <div class="brand">
        <h1>ChatterBox</h1>
        <p>Your community is waiting for you.</p>
      </div>

      <a href="/" class="home-link">← Back to Home</a>
    </div>
  </header>

  <main>
    <section class="login-card">
      <div class="icon-wrapper" aria-hidden="true">🔐</div>

      <p class="eyebrow">Member Access</p>

      <h2>Welcome Back</h2>

      <p class="description">
        Sign in to your clubhouse account and join the conversation.
      </p>

      <% if (error) { %>
        <div class="error-message" role="alert">
          <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <div class="form-group">
          <label for="email">Email Address</label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            required
            autocomplete="email"
            autofocus
          >
        </div>

        <div class="form-group">
          <label for="password">Password</label>

          <div class="password-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter your password"
              required
              autocomplete="current-password"
            >

            <button
              class="toggle-password"
              type="button"
              id="togglePassword"
              aria-controls="password"
              aria-pressed="false"
            >
              Show
            </button>
          </div>
        </div>

        <button class="submit-btn" type="submit">
          Sign In →
        </button>
      </form>

      <div class="signup-prompt">
        Don't have an account?
        <a href="/signup">Create an account</a>
      </div>

      <p class="bottom-link">
        <a href="/">Return to the home page</a>
      </p>
    </section>
  </main>

  <footer class="footer">
    ChatterBox &copy; <%= new Date().getFullYear() %>
    &mdash; Connect, share, and belong.
  </footer>

  <script>
    const passwordInput = document.getElementById("password");
    const togglePassword = document.getElementById("togglePassword");

    togglePassword.addEventListener("click", () => {
      const isPasswordHidden = passwordInput.type === "password";

      passwordInput.type = isPasswordHidden ? "text" : "password";
      togglePassword.textContent = isPasswordHidden ? "Hide" : "Show";
      togglePassword.setAttribute("aria-pressed", String(isPasswordHidden));
    });
  </script>
</body>
</html>
