
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>ChatterBox | Home</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6fb;
      color: #1e293b;
      line-height: 1.7;
      min-height: 100vh;
    }

    a {
      text-decoration: none;
    }

    .header {
      background: #111827;
      color: #fff;
      padding: 20px 5%;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }

    .brand h1 {
      font-size: 28px;
      letter-spacing: -0.5px;
    }

    .brand p {
      color: #cbd5e1;
      font-size: 14px;
      margin-top: 3px;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 17px;
      flex-wrap: wrap;
    }

    .nav a {
      color: #d1d5db;
      font-size: 14px;
      transition: color 0.2s;
    }

    .nav a:hover {
      color: #fff;
    }

    .welcome {
      color: #cbd5e1;
      font-size: 13px;
      border-right: 1px solid #374151;
      padding-right: 17px;
    }

    .nav .signup-link {
      background: #4f46e5;
      color: #fff;
      padding: 9px 14px;
      border-radius: 7px;
      font-weight: 600;
    }

    .nav .signup-link:hover {
      background: #4338ca;
    }

    .logout-form {
      display: inline;
    }

    .logout-btn {
      background: #374151;
      border: 1px solid #4b5563;
      color: #fff;
      padding: 8px 12px;
      border-radius: 7px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
    }

    .logout-btn:hover {
      background: #4b5563;
    }

    .hero {
      background: #1e293b;
      color: #fff;
      padding: 54px 5%;
    }

    .hero-content {
      max-width: 1150px;
      margin: 0 auto;
    }

    .hero-label {
      display: inline-block;
      background: #312e81;
      color: #e0e7ff;
      padding: 5px 11px;
      border-radius: 30px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .hero h2 {
      font-size: clamp(29px, 4vw, 42px);
      line-height: 1.2;
      max-width: 650px;
      margin-bottom: 15px;
    }

    .hero p {
      color: #cbd5e1;
      max-width: 620px;
      font-size: 16px;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 24px;
    }

    .primary-btn,
    .secondary-btn {
      display: inline-block;
      padding: 11px 17px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.2s;
    }

    .primary-btn {
      background: #4f46e5;
      color: #fff;
    }

    .primary-btn:hover {
      background: #4338ca;
    }

    .secondary-btn {
      border: 1px solid #64748b;
      color: #fff;
    }

    .secondary-btn:hover {
      background: #334155;
    }

    .container {
      width: min(1000px, 92%);
      margin: 38px auto;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 22px;
    }

    .section-heading h2 {
      font-size: 25px;
      color: #0f172a;
      margin-bottom: 4px;
    }

    .section-heading p {
      color: #64748b;
      font-size: 14px;
    }

    .message-count {
      color: #64748b;
      background: #e2e8f0;
      padding: 6px 11px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
    }

    .messages-list {
      display: grid;
      gap: 18px;
    }

    .message-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 13px;
      padding: 24px;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.035);
      transition: box-shadow 0.2s, border-color 0.2s;
    }

    .message-card:hover {
      border-color: #cbd5e1;
      box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
    }

    .message-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 12px;
    }

    .message-card h3 {
      font-size: 20px;
      line-height: 1.4;
      color: #0f172a;
      overflow-wrap: anywhere;
    }

    .message-badge {
      flex-shrink: 0;
      background: #eef2ff;
      color: #4338ca;
      padding: 4px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }

    .message-text {
      color: #475569;
      font-size: 15px;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .message-divider {
      height: 1px;
      background: #edf0f5;
      margin: 20px 0 14px;
    }

    .message-meta {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      color: #64748b;
      font-size: 12px;
    }

    .author {
      color: #334155;
      font-weight: 600;
    }

    .member-label {
      color: #047857;
      background: #d1fae5;
      border-radius: 20px;
      padding: 3px 8px;
      font-size: 11px;
      font-weight: 700;
    }

    .empty-state {
      background: #fff;
      border: 1px dashed #cbd5e1;
      border-radius: 13px;
      text-align: center;
      padding: 55px 20px;
    }

    .empty-icon {
      font-size: 36px;
      margin-bottom: 10px;
    }

    .empty-state h3 {
      font-size: 20px;
      color: #1e293b;
      margin-bottom: 8px;
    }

    .empty-state p {
      color: #64748b;
      font-size: 14px;
      margin-bottom: 20px;
    }

    .footer {
      margin-top: 55px;
      padding: 25px 5%;
      border-top: 1px solid #e2e8f0;
      text-align: center;
      color: #94a3b8;
      font-size: 12px;
    }

    @media (max-width: 650px) {
      .header {
        padding: 17px 4%;
      }

      .header-top {
        align-items: flex-start;
      }

      .brand h1 {
        font-size: 25px;
      }

      .nav {
        width: 100%;
        gap: 12px 15px;
      }

      .welcome {
        width: 100%;
        border-right: none;
        padding-right: 0;
      }

      .hero {
        padding: 40px 4%;
      }

      .container {
        margin: 28px auto;
      }

      .section-heading h2 {
        font-size: 22px;
      }

      .message-card {
        padding: 19px;
      }

      .message-card h3 {
        font-size: 18px;
      }

      .message-top {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

<body>
  <header class="header">
    <div class="header-top">
      <div class="brand">
        <h1>ChatterBox</h1>
        <p>Welcome to our exclusive clubhouse!</p>
      </div>

      <nav class="nav">
        <% if (user) { %>
          <span class="welcome">
            Welcome, <%= user.firstName %>!
          </span>

          <a href="/dashboard">Dashboard</a>
          <a href="/messages/create">Create Message</a>

          <% if (!user.isMember) { %>
            <a href="/join-club">Join the Club</a>
          <% } %>

          <form class="logout-form" action="/login/logout" method="POST">
            <button class="logout-btn" type="submit">Log Out</button>
          </form>
        <% } else { %>
          <a href="/login">Login</a>
          <a href="/signup" class="signup-link">Sign Up</a>
        <% } %>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="hero-content">
      <span class="hero-label">YOUR COMMUNITY</span>

      <h2>A place to share ideas and connect.</h2>

      <p>
        Discover what people are talking about, share your thoughts,
        and become part of the ChatterBox community.
      </p>

      <div class="hero-actions">
        <% if (user) { %>
          <a href="/messages/create" class="primary-btn">
            Create a Message
          </a>

          <% if (!user.isMember) { %>
            <a href="/join-club" class="secondary-btn">
              Join the Club
            </a>
          <% } %>
        <% } else { %>
          <a href="/signup" class="primary-btn">Join the Community</a>
          <a href="/login" class="secondary-btn">Log In</a>
        <% } %>
      </div>
    </div>
  </section>

  <main class="container">
    <section>
      <div class="section-heading">
        <div>
          <h2>Community Messages</h2>
          <p>Read what the ChatterBox community is talking about.</p>
        </div>

        <span class="message-count">
          <%= messages ? messages.length : 0 %>
          <%= messages && messages.length === 1 ? "MESSAGE" : "MESSAGES" %>
        </span>
      </div>

      <% if (messages && messages.length > 0) { %>
        <div class="messages-list">
          <% messages.forEach((message) => { %>
            <article class="message-card">
              <div class="message-top">
                <h3><%= message.title %></h3>
                <span class="message-badge">Community Post</span>
              </div>

              <p class="message-text"><%= message.text %></p>

              <% if (user && user.isMember) { %>
                <div class="message-divider"></div>

                <div class="message-meta">
                  <span>
                    Posted by:
                    <span class="author">
                      <%= message.first_name %>
                      <%= message.last_name %>
                    </span>
                  </span>

                  <span>
                    <%= new Date(message.created_at).toLocaleString("en-GB", {
                      dateStyle: "medium",
                      timeStyle: "short",
                      timeZone: "Africa/Addis_Ababa"
                    }) %>
                  </span>
                </div>
              <% } %>
            </article>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-icon" aria-hidden="true">💬</div>

          <h3>No messages yet</h3>

          <p>
            Be the first to share something with the ChatterBox community.
          </p>

          <% if (user) { %>
            <a href="/messages/create" class="primary-btn">
              Create the First Message
            </a>
          <% } else { %>
            <a href="/signup" class="primary-btn">
              Sign Up to Get Started
            </a>
          <% } %>
        </div>
      <% } %>
    </section>
  </main>

  <footer class="footer">
    ChatterBox &copy; <%= new Date().getFullYear() %>
    &mdash; Connect, share, and belong.
  </footer>
</body>
</html>
