
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Dashboard | ChatterBox</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6fb;
      color: #1e293b;
      line-height: 1.6;
      min-height: 100vh;
    }

    a {
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }

    .topbar {
      background: #111827;
      color: #fff;
      padding: 18px 5%;
    }

    .topbar-content {
      width: min(1150px, 100%);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }

    .brand h1 {
      font-size: 25px;
      line-height: 1.3;
    }

    .brand p {
      margin-top: 5px;
      color: #cbd5e1;
      font-size: 13px;
    }

    .navigation {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .navigation a,
    .logout-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 9px 13px;
      border-radius: 7px;
      font-size: 13px;
      font-weight: 600;
      transition: background 0.2s;
    }

    .navigation a {
      color: #e2e8f0;
    }

    .navigation a:hover {
      background: #374151;
    }

    .navigation .primary-link {
      background: #4f46e5;
      color: #fff;
    }

    .navigation .primary-link:hover {
      background: #4338ca;
    }

    .logout-form {
      display: inline;
    }

    .logout-btn {
      border: 1px solid #4b5563;
      background: transparent;
      color: #fca5a5;
      cursor: pointer;
    }

    .logout-btn:hover {
      background: #7f1d1d;
      border-color: #7f1d1d;
      color: #fff;
    }

    main {
      width: min(1150px, 90%);
      margin: 35px auto;
    }

    .welcome-banner {
      background: linear-gradient(120deg, #312e81, #4f46e5);
      color: #fff;
      border-radius: 16px;
      padding: 32px;
      margin-bottom: 28px;
      box-shadow: 0 10px 25px rgba(79, 70, 229, 0.14);
    }

    .welcome-banner .eyebrow {
      color: #c7d2fe;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.4px;
      margin-bottom: 7px;
    }

    .welcome-banner h2 {
      font-size: 29px;
      line-height: 1.3;
      margin-bottom: 10px;
    }

    .welcome-banner p {
      color: #e0e7ff;
      font-size: 14px;
      max-width: 650px;
    }

    .section-heading {
      margin-bottom: 17px;
    }

    .section-heading h2 {
      font-size: 21px;
      color: #0f172a;
    }

    .section-heading p {
      color: #64748b;
      font-size: 13px;
      margin-top: 4px;
    }

    .account-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 13px;
      padding: 25px;
      margin-bottom: 28px;
      box-shadow: 0 4px 15px rgba(15, 23, 42, 0.03);
    }

    .account-heading {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 23px;
    }

    .avatar {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      border-radius: 12px;
      background: #e0e7ff;
      color: #4338ca;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
      font-weight: 700;
    }

    .account-heading h3 {
      font-size: 17px;
      color: #0f172a;
    }

    .account-heading p {
      font-size: 12px;
      color: #64748b;
    }

    .account-details {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .detail-item {
      padding: 15px;
      border: 1px solid #e2e8f0;
      border-radius: 9px;
      min-width: 0;
    }

    .detail-label {
      display: block;
      color: #64748b;
      font-size: 12px;
      margin-bottom: 5px;
    }

    .detail-value {
      color: #0f172a;
      font-size: 14px;
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    .status {
      display: inline-block;
      padding: 4px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }

    .status.member {
      background: #dcfce7;
      color: #166534;
    }

    .status.non-member {
      background: #fef3c7;
      color: #92400e;
    }

    .section-title {
      color: #0f172a;
      font-size: 20px;
      margin-bottom: 5px;
    }

    .section-description {
      color: #64748b;
      font-size: 13px;
      margin-bottom: 20px;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .action-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 13px;
      padding: 25px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      box-shadow: 0 4px 15px rgba(15, 23, 42, 0.03);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .action-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(15, 23, 42, 0.07);
    }

    .action-icon {
      width: 46px;
      height: 46px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 11px;
      font-size: 22px;
      margin-bottom: 17px;
    }

    .icon-purple {
      background: #ede9fe;
    }

    .icon-blue {
      background: #dbeafe;
    }

    .icon-green {
      background: #dcfce7;
    }

    .icon-amber {
      background: #fef3c7;
    }

    .action-card h3 {
      color: #0f172a;
      font-size: 17px;
      margin-bottom: 7px;
    }

    .action-card p {
      color: #64748b;
      font-size: 13px;
      margin-bottom: 20px;
      flex-grow: 1;
    }

    .action-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 14px;
      background: #4f46e5;
      color: #fff;
      border-radius: 7px;
      font-size: 13px;
      font-weight: 700;
      transition: background 0.2s;
    }

    .action-link:hover {
      background: #4338ca;
    }

    .action-link.secondary {
      background: #eef2ff;
      color: #4338ca;
    }

    .action-link.secondary:hover {
      background: #e0e7ff;
    }

    .membership-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 13px;
      padding: 24px;
      margin-bottom: 28px;
      display: flex;
      align-items: flex-start;
      gap: 17px;
    }

    .membership-card.join {
      border-left: 4px solid #d97706;
    }

    .membership-card.join .membership-icon {
      background: #fef3c7;
    }

    .membership-card.member {
      border-left: 4px solid #16a34a;
    }

    .membership-card.member .membership-icon {
      background: #dcfce7;
    }

    .membership-icon {
      width: 45px;
      height: 45px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 21px;
      flex-shrink: 0;
    }

    .membership-content {
      flex: 1;
    }

    .membership-content h3 {
      color: #0f172a;
      font-size: 17px;
      margin-bottom: 6px;
    }

    .membership-content p {
      color: #64748b;
      font-size: 13px;
      margin-bottom: 15px;
    }

    footer {
      text-align: center;
      padding: 24px 15px;
      color: #94a3b8;
      font-size: 12px;
      border-top: 1px solid #e2e8f0;
      background: #fff;
      margin-top: 45px;
    }

    @media (max-width: 760px) {
      .topbar-content {
        align-items: flex-start;
        flex-direction: column;
        gap: 15px;
      }

      .navigation {
        width: 100%;
      }

      main {
        width: 92%;
        margin-top: 25px;
      }

      .welcome-banner {
        padding: 25px 22px;
      }

      .welcome-banner h2 {
        font-size: 25px;
      }

      .cards-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .navigation {
        gap: 7px;
      }

      .navigation a,
      .logout-btn {
        padding: 8px 10px;
        font-size: 12px;
      }

      .account-card {
        padding: 19px;
      }

      .account-details {
        grid-template-columns: 1fr;
      }

      .membership-card {
        padding: 19px;
        gap: 12px;
      }

      .membership-icon {
        width: 38px;
        height: 38px;
      }

      .action-card {
        padding: 21px;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-content">
      <div class="brand">
        <h1>ChatterBox</h1>
        <p>Welcome to your dashboard, <%= user.firstName %>!</p>
      </div>

      <nav class="navigation" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/messages/create" class="primary-link">
          + Create Message
        </a>

        <% if (!user.isMember) { %>
          <a href="/join-club">Join the Club</a>
        <% } %>

        <form
          class="logout-form"
          action="/login/logout"
          method="POST"
        >
          <button class="logout-btn" type="submit">
            Log Out
          </button>
        </form>
      </nav>
    </div>
  </header>

  <main>
    <section class="welcome-banner">
      <p class="eyebrow">Your Personal Space</p>

      <h2>Hello, <%= user.firstName %>! 👋</h2>

      <p>
        Manage your account, check your membership status,
        and share your thoughts with the ChatterBox community.
      </p>
    </section>

    <section class="account-card">
      <div class="account-heading">
        <div class="avatar" aria-hidden="true">
          <%= user.firstName.charAt(0).toUpperCase() %>
        </div>

        <div>
          <h3>Account Information</h3>
          <p>Your personal account details</p>
        </div>
      </div>

      <div class="account-details">
        <div class="detail-item">
          <span class="detail-label">Full Name</span>

          <span class="detail-value">
            <%= user.firstName %> <%= user.lastName %>
          </span>
        </div>

        <div class="detail-item">
          <span class="detail-label">Email Address</span>

          <span class="detail-value">
            <%= user.email %>
          </span>
        </div>

        <div class="detail-item">
          <span class="detail-label">Membership Status</span>

          <% if (user.isMember) { %>
            <span class="status member">Club Member</span>
          <% } else { %>
            <span class="status non-member">Non-Member</span>
          <% } %>
        </div>

        <div class="detail-item">
          <span class="detail-label">Account Type</span>

          <span class="detail-value">Community User</span>
        </div>
      </div>
    </section>

    <% if (!user.isMember) { %>
      <section class="membership-card join">
        <div class="membership-icon" aria-hidden="true">🔑</div>

        <div class="membership-content">
          <h3>Unlock Club Membership</h3>

          <p>
            Become a club member to see message authors and posting
            dates on the home page. You can still read messages and
            create your own without membership.
          </p>

          <a href="/join-club" class="action-link">
            Enter Club Passcode →
          </a>
        </div>
      </section>
    <% } else { %>
      <section class="membership-card member">
        <div class="membership-icon" aria-hidden="true">✓</div>

        <div class="membership-content">
          <h3>You're a Club Member!</h3>

          <p>
            Your membership is active. You can see the authors
            and posting dates of community messages.
          </p>

          <a href="/" class="action-link secondary">
            Explore Community →
          </a>
        </div>
      </section>
    <% } %>

    <section>
      <div class="section-heading">
        <h2 class="section-title">Quick Actions</h2>

        <p class="section-description">
          What would you like to do today?
        </p>
      </div>

      <div class="cards-grid">
        <article class="action-card">
          <div class="action-icon icon-purple" aria-hidden="true">
            ✍️
          </div>

          <h3>Create a Message</h3>

          <p>
            Share an idea, ask a question, or start a conversation
            with the ChatterBox community.
          </p>

          <a href="/messages/create" class="action-link">
            Write a Message →
          </a>
        </article>

        <article class="action-card">
          <div class="action-icon icon-blue" aria-hidden="true">
            💬
          </div>

          <h3>Explore Messages</h3>

          <p>
            Visit the community home page to read messages
            shared by other users.
          </p>

          <a href="/" class="action-link secondary">
            View Messages →
          </a>
        </article>

        <% if (!user.isMember) { %>
          <article class="action-card">
            <div class="action-icon icon-amber" aria-hidden="true">
              🔑
            </div>

            <h3>Join the Club</h3>

            <p>
              Enter your club passcode to unlock member-only
              information on community messages.
            </p>

            <a href="/join-club" class="action-link">
              Become a Member →
            </a>
          </article>
        <% } else { %>
          <article class="action-card">
            <div class="action-icon icon-green" aria-hidden="true">
              ⭐
            </div>

            <h3>Member Benefits</h3>

            <p>
              Your membership lets you see who wrote each message
              and when it was posted.
            </p>

            <a href="/" class="action-link secondary">
              See Member Details →
            </a>
          </article>
        <% } %>
      </div>
    </section>
  </main>

  <footer>
    ChatterBox &copy; <%= new Date().getFullYear() %>
    &mdash; Connect, share, and belong.
  </footer>
</body>
</html>
