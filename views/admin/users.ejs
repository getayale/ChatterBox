
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Users | ChatterBox</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f3f4f6;
      color: #1f2937;
      font-family: Arial, sans-serif;
    }

    header {
      padding: 24px 5%;
      background: #111827;
      color: #fff;
    }

    .header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    header h1 {
      margin: 0 0 8px;
      font-size: 26px;
    }

    header p {
      margin: 0;
      color: #d1d5db;
    }

    nav {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 22px;
    }

    nav a {
      color: #e5e7eb;
      text-decoration: none;
    }

    nav a:hover {
      color: #93c5fd;
    }

    nav form {
      margin: 0;
    }

    nav button {
      padding: 9px 13px;
      border: 1px solid #6b7280;
      border-radius: 6px;
      background: transparent;
      color: #fff;
      cursor: pointer;
    }

    nav button:hover {
      background: #374151;
    }

    main {
      width: 100%;
      max-width: 1200px;
      margin: 32px auto;
      padding: 0 20px;
    }

    .page-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
    }

    .page-heading h2 {
      margin: 0 0 6px;
      font-size: 25px;
    }

    .page-heading p {
      margin: 0;
      color: #6b7280;
    }

    .button {
      display: inline-block;
      padding: 10px 14px;
      border: none;
      border-radius: 7px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }

    .button-primary {
      background: #2563eb;
      color: #fff;
    }

    .button-primary:hover {
      background: #1d4ed8;
    }

    .button-edit {
      background: #dbeafe;
      color: #1d4ed8;
    }

    .button-edit:hover {
      background: #bfdbfe;
    }

    .button-delete {
      background: #fee2e2;
      color: #b91c1c;
    }

    .button-delete:hover {
      background: #fecaca;
    }

    .table-card {
      overflow-x: auto;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th,
    td {
      padding: 16px;
      border-bottom: 1px solid #e5e7eb;
      white-space: nowrap;
    }

    th {
      background: #f9fafb;
      color: #4b5563;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    tbody tr:hover {
      background: #f9fafb;
    }

    .status {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .status-yes {
      background: #dcfce7;
      color: #166534;
    }

    .status-no {
      background: #f3f4f6;
      color: #4b5563;
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .actions form {
      margin: 0;
    }

    .empty-state {
      padding: 40px 20px;
      color: #6b7280;
      text-align: center;
    }

    .back-link {
      display: inline-block;
      margin-top: 24px;
      color: #2563eb;
      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 600px) {
      header {
        padding: 22px 20px;
      }

      main {
        margin-top: 24px;
        padding: 0 12px;
      }

      .page-heading {
        align-items: stretch;
        flex-direction: column;
      }

      .page-heading .button {
        text-align: center;
      }

      th,
      td {
        padding: 12px;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="header-top">
      <div>
        <h1>ChatterBox Admin</h1>
        <p>Manage community users.</p>
      </div>
    </div>

    <nav>
      <a href="/admin">Admin Dashboard</a>
      <a href="/">Home</a>

      <form action="/login/logout" method="POST">
        <button type="submit">Log Out</button>
      </form>
    </nav>
  </header>

  <main>
    <section class="page-heading">
      <div>
        <h2>Manage Users</h2>
        <p>View and manage ChatterBox accounts.</p>
      </div>

      <a href="/admin/users/new" class="button button-primary">
        + Create New User
      </a>
    </section>

    <% if (users.length === 0) { %>
      <section class="table-card">
        <div class="empty-state">
          <h3>No users found</h3>
          <p>Create a new user to get started.</p>
        </div>
      </section>
    <% } else { %>
      <section class="table-card">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Club Member</th>
              <th>Admin</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% users.forEach((account) => { %>
              <tr>
                <td><%= account.id %></td>

                <td>
                  <strong>
                    <%= account.first_name %> <%= account.last_name %>
                  </strong>
                </td>

                <td><%= account.email %></td>

                <td>
                  <span class="status <%= account.is_member ? 'status-yes' : 'status-no' %>">
                    <%= account.is_member ? "Yes" : "No" %>
                  </span>
                </td>

                <td>
                  <span class="status <%= account.is_admin ? 'status-yes' : 'status-no' %>">
                    <%= account.is_admin ? "Yes" : "No" %>
                  </span>
                </td>

                <td>
                  <div class="actions">
                    <% if (!account.is_admin) { %>
                      <a
                        href="/admin/users/<%= account.id %>/edit"
                        class="button button-edit"
                      >
                        Edit
                      </a>

                      <form
                        action="/admin/users/<%= account.id %>/delete"
                        method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');"
                      >
                        <button
                          type="submit"
                          class="button button-delete"
                        >
                          Delete
                        </button>
                      </form>
                    <% } else { %>
                      <span class="status status-no">
                        Protected
                      </span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% } %>

    <a href="/admin" class="back-link">
      &larr; Back to Admin Dashboard
    </a>
  </main>
</body>
</html>
