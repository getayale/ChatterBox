
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Messages | ChatterBox Admin</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6fb;
      color: #1e293b;
      line-height: 1.6;
    }

    .topbar {
      background: #111827;
      color: white;
      padding: 18px 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .brand {
      font-size: 21px;
      font-weight: 700;
    }

    .nav {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .nav a {
      color: #d1d5db;
      text-decoration: none;
      font-size: 14px;
    }

    .nav a:hover {
      color: white;
    }

    .logout-form {
      display: inline;
    }

    .logout-btn {
      background: #374151;
      color: white;
      border: none;
      border-radius: 6px;
      padding: 9px 13px;
      cursor: pointer;
    }

    .logout-btn:hover {
      background: #4b5563;
    }

    .container {
      width: min(1200px, 92%);
      margin: 35px auto;
    }

    .page-heading {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    h1 {
      font-size: 28px;
      margin-bottom: 5px;
    }

    .subtitle {
      color: #64748b;
      font-size: 14px;
    }

    .back-btn {
      display: inline-block;
      padding: 10px 15px;
      background: white;
      color: #334155;
      border: 1px solid #dbe2ea;
      border-radius: 7px;
      text-decoration: none;
      font-size: 14px;
      font-weight: 600;
    }

    .back-btn:hover {
      background: #f8fafc;
    }

    .summary {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 22px;
      box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .summary-label {
      color: #64748b;
      font-size: 13px;
    }

    .summary-number {
      display: block;
      font-size: 30px;
      font-weight: 700;
      margin-top: 4px;
    }

    .table-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .table-header {
      padding: 18px 20px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 17px;
      font-weight: 700;
    }

    .table-wrapper {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 850px;
    }

    th,
    td {
      padding: 15px 18px;
      text-align: left;
      border-bottom: 1px solid #edf0f5;
      vertical-align: top;
    }

    th {
      background: #f8fafc;
      color: #64748b;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    td {
      font-size: 14px;
    }

    tbody tr:hover {
      background: #fafcff;
    }

    .message-title {
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 5px;
    }

    .message-text {
      color: #64748b;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      max-width: 380px;
    }

    .author-name {
      font-weight: 600;
    }

    .author-email {
      display: block;
      color: #64748b;
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .date {
      white-space: nowrap;
      color: #475569;
    }

    .delete-btn {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      border-radius: 6px;
      padding: 8px 11px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    .delete-btn:hover {
      background: #fecaca;
    }

    .empty-state {
      padding: 50px 20px;
      text-align: center;
      color: #64748b;
    }

    .empty-state h2 {
      color: #334155;
      font-size: 20px;
      margin-bottom: 8px;
    }

    .footer {
      text-align: center;
      color: #94a3b8;
      font-size: 12px;
      padding: 25px 15px;
    }

    @media (max-width: 600px) {
      .topbar {
        padding: 16px 4%;
      }

      .nav {
        gap: 12px;
      }

      .container {
        margin: 24px auto;
      }

      h1 {
        font-size: 24px;
      }

      .page-heading {
        align-items: stretch;
      }

      .back-btn {
        text-align: center;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="brand">ChatterBox Admin</div>

    <nav class="nav">
      <a href="/admin">Dashboard</a>
      <a href="/admin/users">Users</a>
      <a href="/">View Site</a>

      <form class="logout-form" action="/login/logout" method="POST">
        <button class="logout-btn" type="submit">Logout</button>
      </form>
    </nav>
  </header>

  <main class="container">
    <div class="page-heading">
      <div>
        <h1>Manage Messages</h1>
        <p class="subtitle">
          View messages posted by members and other users.
        </p>
      </div>

      <a class="back-btn" href="/admin">Back to Dashboard</a>
    </div>

    <section class="summary">
      <span class="summary-label">Total Messages</span>
      <span class="summary-number"><%= messages.length %></span>
    </section>

    <section class="table-card">
      <div class="table-header">All Messages</div>

      <% if (messages.length > 0) { %>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Message</th>
                <th>Author</th>
                <th>Posted Date</th>
                <th>Action</th>
              </tr>
            </thead>

            <tbody>
              <% messages.forEach((message) => { %>
                <tr>
                  <td><%= message.id %></td>

                  <td>
                    <div class="message-title">
                      <%= message.title %>
                    </div>

                    <div class="message-text">
                      <%= message.text %>
                    </div>
                  </td>

                  <td>
                    <span class="author-name">
                      <%= message.first_name %>
                      <%= message.last_name %>
                    </span>

                    <span class="author-email">
                      <%= message.email %>
                    </span>
                  </td>

                  <td class="date">
                    <%= new Date(message.created_at).toLocaleString("en-GB", {
                      dateStyle: "medium",
                      timeStyle: "short",
                      timeZone: "Africa/Addis_Ababa"
                    }) %>
                  </td>

                  <td>
                    <form
                      action="/admin/messages/<%= message.id %>/delete"
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this message?');"
                    >
                      <button class="delete-btn" type="submit">
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h2>No messages yet</h2>
          <p>Messages will appear here when users post them.</p>
        </div>
      <% } %>
    </section>
  </main>

  <footer class="footer">
    ChatterBox Administration
  </footer>
</body>
</html>
