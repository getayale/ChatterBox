
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Create Message | ChatterBox</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f3f6fb;
      color: #1e293b;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      text-decoration: none;
    }

    .topbar {
      background: #111827;
      color: #fff;
      padding: 18px 5%;
    }

    .topbar-content {
      width: min(1100px, 100%);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .brand h1 {
      font-size: 25px;
      line-height: 1.3;
    }

    .brand p {
      color: #cbd5e1;
      font-size: 13px;
      margin-top: 4px;
    }

    .navigation {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .navigation a {
      color: #e2e8f0;
      padding: 9px 13px;
      border-radius: 7px;
      font-size: 13px;
      font-weight: 600;
      transition: background 0.2s;
    }

    .navigation a:hover {
      background: #374151;
    }

    .navigation .dashboard-link {
      background: #4f46e5;
      color: #fff;
    }

    .navigation .dashboard-link:hover {
      background: #4338ca;
    }

    main {
      width: min(720px, 92%);
      margin: 42px auto;
      flex: 1;
    }

    .page-heading {
      margin-bottom: 25px;
    }

    .eyebrow {
      color: #4f46e5;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.3px;
      text-transform: uppercase;
      margin-bottom: 7px;
    }

    .page-heading h2 {
      color: #0f172a;
      font-size: 30px;
      line-height: 1.3;
      margin-bottom: 9px;
    }

    .page-heading p {
      color: #64748b;
      font-size: 14px;
    }

    .form-card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 15px;
      padding: 30px;
      box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
    }

    .form-intro {
      display: flex;
      align-items: center;
      gap: 14px;
      padding-bottom: 22px;
      margin-bottom: 24px;
      border-bottom: 1px solid #e2e8f0;
    }

    .form-icon {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: #e0e7ff;
      font-size: 23px;
    }

    .form-intro h3 {
      color: #0f172a;
      font-size: 16px;
      margin-bottom: 3px;
    }

    .form-intro p {
      color: #64748b;
      font-size: 12px;
    }

    .error-message {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 13px 15px;
      font-size: 13px;
      margin-bottom: 22px;
    }

    .form-group {
      margin-bottom: 22px;
    }

    label {
      display: block;
      color: #334155;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .optional-label {
      color: #94a3b8;
      font-size: 11px;
      font-weight: 400;
      margin-left: 5px;
    }

    input,
    textarea {
      width: 100%;
      display: block;
      padding: 13px 14px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      background: #fff;
      color: #0f172a;
      font-family: inherit;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input::placeholder,
    textarea::placeholder {
      color: #94a3b8;
    }

    input:focus,
    textarea:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
    }

    textarea {
      min-height: 190px;
      resize: vertical;
      line-height: 1.7;
    }

    .field-hint {
      color: #94a3b8;
      font-size: 12px;
      margin-top: 7px;
    }

    .character-count {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 7px;
      color: #94a3b8;
      font-size: 11px;
    }

    .form-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      padding-top: 8px;
    }

    .publish-btn,
    .cancel-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 43px;
      padding: 11px 17px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .publish-btn {
      background: #4f46e5;
      color: #fff;
      border: 1px solid #4f46e5;
    }

    .publish-btn:hover {
      background: #4338ca;
      border-color: #4338ca;
    }

    .cancel-btn {
      background: #fff;
      color: #475569;
      border: 1px solid #cbd5e1;
    }

    .cancel-btn:hover {
      background: #f8fafc;
      border-color: #94a3b8;
    }

    .form-note {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-top: 25px;
      padding: 14px;
      border-radius: 9px;
      background: #f8fafc;
      color: #64748b;
      font-size: 12px;
    }

    .form-note strong {
      color: #475569;
    }

    footer {
      background: #fff;
      border-top: 1px solid #e2e8f0;
      color: #94a3b8;
      text-align: center;
      padding: 22px 15px;
      font-size: 12px;
    }

    @media (max-width: 600px) {
      .topbar {
        padding: 17px 4%;
      }

      .topbar-content {
        align-items: flex-start;
        flex-direction: column;
        gap: 13px;
      }

      main {
        margin: 28px auto;
      }

      .page-heading h2 {
        font-size: 26px;
      }

      .form-card {
        padding: 22px 18px;
      }

      .form-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .publish-btn,
      .cancel-btn {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-content">
      <div class="brand">
        <h1>ChatterBox</h1>
        <p>Your voice, your community.</p>
      </div>

      <nav class="navigation" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/dashboard" class="dashboard-link">Dashboard</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="page-heading">
      <p class="eyebrow">Community</p>

      <h2>Create a Message</h2>

      <p>
        Have something to share? Start a conversation with
        the ChatterBox community.
      </p>
    </section>

    <section class="form-card">
      <div class="form-intro">
        <div class="form-icon" aria-hidden="true">✍️</div>

        <div>
          <h3>Write your message</h3>
          <p>Give your post a title and share your thoughts.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="error-message" role="alert">
          <strong>Unable to publish:</strong>
          <%= error %>
        </div>
      <% } %>

      <form action="/messages/create" method="POST">
        <div class="form-group">
          <label for="title">Message Title</label>

          <input
            type="text"
            id="title"
            name="title"
            maxlength="200"
            placeholder="Give your message a clear title"
            required
          >

          <div class="character-count">
            <span>Keep your title short and meaningful.</span>
            <span id="titleCount">0 / 200</span>
          </div>
        </div>

        <div class="form-group">
          <label for="text">Your Message</label>

          <textarea
            id="text"
            name="text"
            rows="8"
            placeholder="What's on your mind? Share your ideas, questions, or experiences..."
            required
          ></textarea>

          <p class="field-hint">
            Be respectful and keep the conversation constructive.
          </p>
        </div>

        <div class="form-actions">
          <button type="submit" class="publish-btn">
            Publish Message →
          </button>

          <a href="/" class="cancel-btn">Cancel</a>
        </div>
      </form>

      <div class="form-note">
        <span aria-hidden="true">ℹ️</span>

        <p>
          <strong>Good to know:</strong>
          Your message will appear on the community home page.
          Club members can also see the author's name and posting date.
        </p>
      </div>
    </section>
  </main>

  <footer>
    ChatterBox &copy; <%= new Date().getFullYear() %>
    &mdash; Connect, share, and belong.
  </footer>

  <script>
    const titleInput = document.getElementById("title");
    const titleCount = document.getElementById("titleCount");

    titleInput.addEventListener("input", () => {
      titleCount.textContent = `${titleInput.value.length} / 200`;
    });
  </script>
</body>
</html>
